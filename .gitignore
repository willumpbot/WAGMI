# Local env files & secrets
infra/.env
.env
.env.*
!bot/.env.example
!.env.example
!bot/.env.production.example
# Explicit block: future .env.production populated with real keys stays out of git
bot/.env.production
*.key
*.pem
*.json.bak

# Python caches & artifacts
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# Node modules & build (frontend)
web/node_modules/
web/.next/
web/out/
node_modules/

# Docker & logs
*.log
docker-compose.override.yml

# Bot runtime data (generated at runtime, not committed)
data/
ml_data/
bot/ml_data/
bot/backtest_ml_data/
bot/logs/
bot/paper_trades/
bot/backtest_results/
# Runtime CSV/JSON outputs (not source code)
bot/data/trades.csv
bot/data/analysis/
bot/data/ml/
bot/data/logs/
bot/data/backtest/

# Re-include Python SOURCE modules under bot/data/ (runtime csv/json above stay ignored).
# The broad `data/` rule silently ignored bot/data/*.py source files — so `git add` on a
# new source module there did nothing without erroring (this hid epoch.py/trade_source.py
# from git despite a commit message claiming to add them). These negations keep runtime
# data ignored via `bot/data/**` while re-including only .py source. Enforced by
# tests/test_source_tracked.py.
!bot/data/
bot/data/**
!bot/data/**/
!bot/data/*.py
!bot/data/**/*.py

# Re-include the laptop mining deliverables (mission reports + small compressed
# datasets the server pulls). `bot/data/**` above would otherwise silently drop
# them -- exactly the trap the comment further up describes, which bit again on
# 2026-10-08. Raw candle stores stay ignored via bot/data/laptop_mining/.gitignore.
!bot/data/laptop_mining/
!bot/data/laptop_mining/*.md
!bot/data/laptop_mining/*.json
!bot/data/laptop_mining/*.jsonl.gz

# Re-include frontend fallback snapshots (the broad `data/` rule above also caught
# web/public/data). These JSONs are the CDN-served last-known-data fallback for the
# site when the bot PC / ngrok tunnel is offline — they ARE deployable content.
!web/public/data/
!web/public/data/*.json

# IDE & editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary & OS
*.tmp
*.bak
Thumbs.db

# Export artifacts
infra/nunuirl-platform-clean.zip
infra/staging/
.vercel

# Ephemeral Claude agent worktrees — each is a FULL repo checkout, never commit
# (a bare `git add -A` otherwise stages ~11.6k paths from these).
.claude/worktrees/

# Local machine cleanup snapshots (2026-09-07 box cleanup), not source
_system_cleanup_*/
*.lnk

# Replay sandbox: a 656MB vendored fixture (bot/data/replay/C1/sandbox is an
# entire separate codebase copy). The `!bot/data/**/*.py` negation above would
# otherwise drag ~11.4k of its .py files into the repo. Runtime fixture, not source.
bot/data/replay/
