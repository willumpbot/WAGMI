# Local env files & secrets
infra/.env
.env
.env.*
!bot/.env.example
!.env.example
!bot/.env.production.example
# Explicit block: future .env.production populated with real keys stays out of git
bot/.env.production
*.key
*.pem
*.json.bak

# Python caches & artifacts
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# Node modules & build (frontend)
web/node_modules/
web/.next/
web/out/
node_modules/

# Docker & logs
*.log
docker-compose.override.yml

# Bot runtime data (generated at runtime, not committed)
data/
ml_data/
bot/ml_data/
bot/backtest_ml_data/
bot/logs/
bot/paper_trades/
bot/backtest_results/
# Runtime CSV/JSON outputs (not source code)
bot/data/trades.csv
bot/data/analysis/
bot/data/ml/
bot/data/logs/
bot/data/backtest/

# Re-include Python SOURCE modules under bot/data/ (runtime csv/json above stay ignored).
# The broad `data/` rule silently ignored bot/data/*.py source files — so `git add` on a
# new source module there did nothing without erroring (this hid epoch.py/trade_source.py
# from git despite a commit message claiming to add them). These negations keep runtime
# data ignored via `bot/data/**` while re-including only .py source. Enforced by
# tests/test_source_tracked.py.
!bot/data/
bot/data/**
!bot/data/**/
!bot/data/*.py
!bot/data/**/*.py

# IDE & editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary & OS
*.tmp
*.bak
Thumbs.db

# Export artifacts
infra/nunuirl-platform-clean.zip
infra/staging/
